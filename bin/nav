#!/bin/bash
# nav - CLI del skill de navegación de sesiones Claude Code.
# Subcomandos: list | jump <patrón> | spawn <ruta> | worktrees <ruta-de-proyecto>
#              sweep [<ruta>] (qué sobra) | prune <ruta> (retirar uno) | scan

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/registry.sh
source "$SCRIPT_DIR/../lib/registry.sh"

status_icon() {
  case "$1" in
    working) echo "🤖" ;;
    blocked) echo "🙋" ;;
    idle) echo "💤" ;;
    "sin sesión") echo "  " ;;
    *) echo "❔" ;;
  esac
}

# Aplana el árbol padre/hijo (ver spawn_build_launcher / hook-handler.sh)
# en el orden en que hay que imprimirlo: raíces agrupadas por proyecto,
# cada una seguida inmediatamente de sus descendientes, con ".depth"
# marcando cuántos niveles bajar. Una entrada es raíz si no tiene
# parent_cwd, o si su padre ya no está entre las sesiones vivas — un padre
# cerrado no debe esconder al hijo del listado.
list_flatten_tree() {
  jq -cs '
    def byCwd($all): $all | map({(.cwd): .}) | add // {};
    def childrenOf($all): $all | group_by(.parent_cwd // "")
      | map({key: (.[0].parent_cwd // ""), value: .}) | from_entries;
    def descend($childrenOf; node; depth):
        (node + {depth: depth}),
        ( ($childrenOf[node.cwd] // []) | sort_by(.project, .cwd)[]
          | descend($childrenOf; .; depth + 1) )
      ;
    . as $all
    | byCwd($all) as $byCwd
    | childrenOf($all) as $childrenOf
    | ( $all
        | map(select( ((.parent_cwd // "") == "")
                      or ($byCwd[(.parent_cwd // "")] == null) ))
        | sort_by(.project, .cwd)[] )
    | descend($childrenOf; .; 0)
  '
}

cmd_list() {
  local entries
  entries=$(registry_list_live)
  if [ -z "$entries" ]; then
    echo "No hay sesiones activas."
    return
  fi

  # Pass 1: resolver por sesión lo que solo se puede saber en vivo (rama
  # actual, ruta a mostrar) y quedarnos con parent_cwd tal cual está en el
  # registro. El propio árbol (orden, profundidad) lo calcula jq después
  # en list_flatten_tree — bash aquí solo prepara los datos por entrada.
  local augmented=()
  while IFS= read -r entry; do
    local project branch status cwd worktree updated_at display_path subpath parent_cwd
    project=$(echo "$entry" | jq -r '.project // "(sin git)"')
    status=$(echo "$entry" | jq -r '.status // "unknown"')
    cwd=$(echo "$entry" | jq -r '.cwd')
    worktree=$(echo "$entry" | jq -r '.worktree // .cwd')
    updated_at=$(echo "$entry" | jq -r '.updated_at // ""')
    parent_cwd=$(echo "$entry" | jq -r '.parent_cwd // ""')

    # La rama se resuelve EN VIVO, no se confía en la guardada en el
    # registro: si Claude ha hecho "git checkout -b" dentro del mismo
    # worktree (sin crear uno nuevo), el cwd no cambia pero la rama sí,
    # y la del registro se quedó congelada en la del arranque de la sesión.
    branch=$(git -C "$worktree" branch --show-current 2>/dev/null) || true
    [ -z "$branch" ] && branch=$(echo "$entry" | jq -r '.branch // ""')

    # Si la sesión corre en una subcarpeta del worktree (típico en
    # monorepos: backend/gateway, backend/platform-worker...) en vez de
    # en su raíz, mostrar la subcarpeta explícitamente. Si no, dos
    # sesiones distintas en subcarpetas distintas del MISMO worktree se
    # ven indistinguibles (las dos muestran solo la raíz del worktree).
    if [ "$cwd" != "$worktree" ] && [ -n "$worktree" ] && [[ "$cwd" == "$worktree"/* ]]; then
      subpath="${cwd#"$worktree"/}"
      display_path="$worktree ($subpath)"
    else
      display_path="$worktree"
    fi

    augmented+=("$(jq -n \
      --arg project "$project" --arg status "$status" --arg cwd "$cwd" \
      --arg branch "$branch" --arg display_path "$display_path" \
      --arg updated_at "$updated_at" --arg parent_cwd "$parent_cwd" \
      '{project:$project, status:$status, cwd:$cwd, branch:$branch,
        display_path:$display_path, updated_at:$updated_at,
        parent_cwd:$parent_cwd}')")
  done <<< "$entries"

  local prev_project="" depth project status branch display_path updated_at parent_cwd row indent i note
  while IFS= read -r row; do
    project=$(echo "$row" | jq -r '.project')
    status=$(echo "$row" | jq -r '.status')
    branch=$(echo "$row" | jq -r '.branch')
    display_path=$(echo "$row" | jq -r '.display_path')
    updated_at=$(echo "$row" | jq -r '.updated_at')
    parent_cwd=$(echo "$row" | jq -r '.parent_cwd')
    depth=$(echo "$row" | jq -r '.depth')

    if [ "$depth" -eq 0 ]; then
      if [ "$project" != "$prev_project" ]; then
        echo ""
        echo "📁 $project"
        prev_project="$project"
      fi
      # Raíz "de verdad" (nunca tuvo padre) vs. huérfana (su padre existió
      # pero esa sesión ya se cerró) — ambas se pintan sin indentar, pero
      # vale la pena distinguirlas: la huérfana sí venía de algún sitio.
      note=""
      [ -n "$parent_cwd" ] && note="  [huérfana: padre cerrado]"
      printf "   %s [%-30s] %s  (act. %s)%s\n" "$(status_icon "$status")" "$branch" "$display_path" "$updated_at" "$note"
    else
      indent=""
      for ((i = 0; i < depth; i++)); do indent="  $indent"; done
      printf "   %s↳ %s [%-30s] %s  (act. %s)\n" "$indent" "$(status_icon "$status")" "$branch" "$display_path" "$updated_at"
    fi
  done < <(printf '%s\n' "${augmented[@]}" | list_flatten_tree)
}

jump_to_tty() {
  # ps da "ttys014"; el AppleScript de Terminal.app devuelve "/dev/ttys014".
  local target_tty="/dev/${1#/dev/}"
  local target_dir_name="$2"
  osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  set foundTab to false
  repeat with w in windows
    repeat with t in tabs of w
      try
        if (tty of t) is "$target_tty" then
          set frontmost of w to true
          set selected tab of w to t
          set foundTab to true
          exit repeat
        end if
      end try
    end repeat
    if foundTab then exit repeat
  end repeat
  if not foundTab then
    repeat with w in windows
      try
        if name of w contains "$target_dir_name" then
          set frontmost of w to true
          set foundTab to true
          exit repeat
        end if
      end try
    end repeat
  end if
  return foundTab
end tell
APPLESCRIPT
}

cmd_jump() {
  local pattern="${1:-}"
  if [ -z "$pattern" ]; then
    echo "Uso: nav jump <patrón de proyecto/worktree>" >&2
    exit 1
  fi

  local matches
  matches=$(registry_list_live | jq -c --arg p "$pattern" \
    'select(((.worktree // .cwd) | test($p; "i")) or ((.project // "") | test($p; "i")))')

  local count
  count=$(echo "$matches" | jq -s 'length')

  if [ "$count" -eq 0 ]; then
    echo "No hay ninguna sesión activa que coincida con '$pattern'." >&2
    exit 1
  fi

  if [ "$count" -gt 1 ]; then
    echo "Hay varias coincidencias, sé más específico:" >&2
    # .cwd, no .worktree: en monorepos, varias sesiones distintas en
    # subcarpetas del mismo worktree comparten la misma raíz de worktree
    # y se verían idénticas si mostrásemos eso en vez del cwd real.
    echo "$matches" | jq -r '"  " + .cwd + "  [" + (.status // "unknown") + "]"' >&2
    exit 1
  fi

  local tty worktree dir_name found
  tty=$(echo "$matches" | jq -r '.tty')
  worktree=$(echo "$matches" | jq -r '.worktree // .cwd')
  dir_name=$(basename "$worktree")

  found=$(jump_to_tty "$tty" "$dir_name") || true
  if [ "$found" != "true" ]; then
    echo "No se encontró la pestaña (tty=$tty) en Terminal.app. ¿Sigue abierta?" >&2
    exit 1
  fi
}

# Crea (o reutiliza si ya existe) un worktree hermano del repo. Imprime
# DOS líneas por stdout: la ruta, y "new"/"existing" según si la rama se
# acaba de crear ahora mismo o ya existía — cmd_spawn usa esa segunda
# línea para decidir si hace falta avisar a Claude de que no cree otra
# rama encima. El resto de mensajes van a stderr para no ensuciar eso.
spawn_create_worktree() {
  local from_path="$1" branch="$2" base="$3"
  local project_root project_name safe_suffix new_path branch_existed

  project_root=$(git -C "$from_path" worktree list 2>/dev/null | head -1 | awk '{print $1}') || true
  if [ -z "$project_root" ]; then
    echo "'$from_path' no es un repositorio git." >&2
    exit 1
  fi
  project_name=$(basename "$project_root")
  safe_suffix=$(echo "$branch" | tr '/' '-')
  new_path="$(dirname "$project_root")/${project_name}-${safe_suffix}"

  if [ -e "$new_path" ]; then
    echo "$new_path"
    echo "existing"
    return
  fi

  if [ -z "$base" ]; then
    base=$(git -C "$from_path" branch --show-current) || true
    [ -z "$base" ] && base="HEAD"
  fi

  if git -C "$project_root" show-ref --verify --quiet "refs/heads/$branch"; then
    branch_existed="existing"
    git -C "$project_root" worktree add "$new_path" "$branch" >&2
  else
    branch_existed="new"
    git -C "$project_root" worktree add "$new_path" -b "$branch" "$base" >&2
  fi

  echo "$new_path"
  echo "$branch_existed"
}

# Prepara un lanzador de usar-y-tirar en ~/.claude-nav/tmp/ que hace
# cd + claude [prompt inicial]. Todo el contenido dinámico (ruta, prompt)
# se escribe a ficheros aparte con printf %s (sin interpretar nada); el
# propio script es un heredoc ESTÁTICO (delimitador entre comillas, cero
# interpolación). Así evitamos el triple escapado bash -> AppleScript ->
# shell-de-Terminal, que es donde se cuelan los bugs de inyección si
# intentas meter texto arbitrario directamente en la cadena de AppleScript.
# Traduce el modo de permisos (tal como lo nombra Claude Code) al flag con el
# que se arranca una sesión nueva. Sin argumento, hereda el de la sesión que
# está ejecutando nav: el hook guarda `permission_mode` en el registro con cada
# evento, así que refleja el modo de AHORA y no el de arranque — que es la
# diferencia que importa cuando alguien lo ha cambiado con shift+tab.
#
# Devuelve vacío si no hay nada que heredar; decide el llamante.
spawn_permission_flag() {
  local mode="$1"
  if [ -z "$mode" ]; then
    mode=$(registry_get "$PWD" | jq -r '.permission_mode // empty' 2>/dev/null) || true
  fi
  case "$mode" in
    "")                : ;;
    bypassPermissions) printf '%s' "--dangerously-skip-permissions" ;;
    default|manual)    printf '%s' "--permission-mode manual" ;;
    *)                 printf '%s' "--permission-mode $mode" ;;
  esac
}

spawn_build_launcher() {
  local target_path="$1" prompt="$2" remote_name="$3" permission_flag="$4" fork_session_id="$5"
  local parent_cwd="$6" parent_session_id="$7"
  local launch_dir
  mkdir -p "$HOME/.claude-nav/tmp"
  launch_dir=$(mktemp -d "$HOME/.claude-nav/tmp/launch.XXXXXX")

  printf '%s' "$target_path" > "$launch_dir/path"
  [ -n "$prompt" ] && printf '%s' "$prompt" > "$launch_dir/prompt"
  [ -n "$remote_name" ] && printf '%s' "$remote_name" > "$launch_dir/remote_name"
  [ -n "$fork_session_id" ] && printf '%s' "$fork_session_id" > "$launch_dir/fork_session_id"
  [ -n "$permission_flag" ] && printf '%s' "$permission_flag" > "$launch_dir/permission_flag"
  # Linaje para el árbol de "nav list": quién ha lanzado esta sesión. Se pasa
  # por variable de entorno (no por argv de claude) para que el hook de
  # SessionStart lo capture sin depender de parsear la línea de comandos.
  [ -n "$parent_cwd" ] && printf '%s' "$parent_cwd" > "$launch_dir/parent_cwd"
  [ -n "$parent_session_id" ] && printf '%s' "$parent_session_id" > "$launch_dir/parent_session_id"

  cat > "$launch_dir/run.sh" <<'LAUNCHER'
#!/bin/bash
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$(cat "$DIR/path")" || exit 1
[ -f "$DIR/parent_cwd" ] && export CLAUDE_NAV_PARENT_CWD="$(cat "$DIR/parent_cwd")"
[ -f "$DIR/parent_session_id" ] && export CLAUDE_NAV_PARENT_SESSION_ID="$(cat "$DIR/parent_session_id")"
CMD=(claude)
if [ -s "$DIR/permission_flag" ]; then
  # El fichero trae el flag ya resuelto y puede ser de dos palabras
  # ("--permission-mode auto"), así que se parte en el array en vez de
  # meterse como un solo argumento.
  read -r -a PERM < "$DIR/permission_flag" || true
  CMD+=("${PERM[@]}")
fi
if [ -f "$DIR/remote_name" ]; then
  CMD+=(--remote-control "$(cat "$DIR/remote_name")")
fi
if [ -f "$DIR/fork_session_id" ]; then
  CMD+=(--resume "$(cat "$DIR/fork_session_id")" --fork-session)
fi
if [ -f "$DIR/prompt" ]; then
  CMD+=("$(cat "$DIR/prompt")")
fi
"${CMD[@]}"
rm -rf "$DIR"
LAUNCHER
  chmod +x "$launch_dir/run.sh"

  echo "$launch_dir/run.sh"
}

cmd_spawn() {
  local mode="tab"
  local target_path=""
  local new_branch=""
  local base_branch=""
  local prompt=""
  local remote_control=true
  local skip_permissions=true
  local forced_mode=""
  local fork=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --window) mode="window"; shift ;;
      --tab) mode="tab"; shift ;;
      --worktree) new_branch="$2"; shift 2 ;;
      --from) base_branch="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      --no-remote-control) remote_control=false; shift ;;
      --no-skip-permissions) skip_permissions=false; shift ;;
      --permission-mode) forced_mode="$2"; shift 2 ;;
      --fork) fork=true; shift ;;
      *) target_path="$1"; shift ;;
    esac
  done

  if [ -z "$target_path" ] || [ ! -d "$target_path" ]; then
    echo "Uso: nav spawn [--window|--tab] [--worktree <rama> [--from <rama-base>]] [--prompt <texto>] [--fork] [--no-remote-control] [--permission-mode <modo>] [--no-skip-permissions] <ruta-existente>" >&2
    exit 1
  fi
  target_path=$(cd "$target_path" && pwd)
  local source_path="$target_path"

  # --fork: hereda el historial completo (claude --resume <id> --fork-session)
  # de la sesión de Claude Code registrada en $source_path, en vez de solo
  # un --prompt escrito a mano. El session_id sale del propio registro de
  # nav (lo capturan los hooks, es un campo documentado del payload de
  # hooks) — no leemos nada interno de ~/.claude/projects/.
  #
  # Ojo con la working copy: --resume solo restaura la CONVERSACIÓN, no
  # el estado de ficheros. Si $source_path tiene cambios sin commitear, el
  # worktree nuevo (checkout limpio) no los tendrá, y la conversación
  # heredada puede hacer referencia a ediciones que ahí no existen.
  # Avisamos, no bloqueamos — a diferencia de nav prune, forkear no es
  # destructivo.
  local fork_session_id=""
  if [ "$fork" = "true" ]; then
    fork_session_id=$(registry_get "$source_path" | jq -r '.session_id // empty' 2>/dev/null) || true
    if [ -z "$fork_session_id" ]; then
      echo "Aviso: no hay session_id registrado para '$source_path' (¿tiene una sesión activa con nav instalado?). Lanzando sin --fork." >&2
    elif [ -n "$(git -C "$source_path" status --porcelain 2>/dev/null)" ]; then
      echo "Aviso: '$source_path' tiene cambios sin commitear que NO se copiarán al worktree nuevo — la conversación heredada puede hacer referencia a ediciones que ahí no existen." >&2
    fi
  fi

  if [ -n "$new_branch" ]; then
    local worktree_result branch_status
    worktree_result=$(spawn_create_worktree "$target_path" "$new_branch" "$base_branch")
    target_path=$(echo "$worktree_result" | head -1)
    branch_status=$(echo "$worktree_result" | tail -1)

    if [ "$branch_status" = "new" ]; then
      local note="Este worktree se ha creado específicamente para la rama '$new_branch', que ya tienes activa aquí. No crees otra rama encima salvo que se te pida explícitamente."
      if [ -n "$prompt" ]; then
        prompt="$note"$'\n\n'"$prompt"
      else
        prompt="$note"
      fi
    fi
  fi

  # Nombre de sesión para --remote-control: la rama pensada para este
  # worktree si se usó --worktree, si no la rama actual de destino, si no
  # el nombre del directorio. Se sanea la barra ("feature/x" -> "feature-x")
  # porque la doc de --remote-control no confirma que acepte "/" en el
  # nombre y no vale la pena arriesgarse.
  local remote_name=""
  if [ "$remote_control" = "true" ]; then
    remote_name="$new_branch"
    if [ -z "$remote_name" ]; then
      remote_name=$(git -C "$target_path" branch --show-current 2>/dev/null) || true
    fi
    [ -z "$remote_name" ] && remote_name=$(basename "$target_path")
    remote_name=$(echo "$remote_name" | tr '/' '-')
  fi

  # Modo de permisos de la sesión nueva: el mismo que el de quien la abre,
  # salvo que se pida otro. Antes se forzaba SIEMPRE el bypass, que es cómodo
  # pero convierte cualquier sesión lanzada desde una sesión prudente en una
  # que no pregunta nada — una decisión de seguridad tomada por omisión.
  local permission_flag=""
  if [ "$skip_permissions" = "false" ]; then
    permission_flag="--permission-mode manual"
  else
    permission_flag=$(spawn_permission_flag "$forced_mode")
    if [ -z "$permission_flag" ]; then
      echo "Aviso: no se pudo leer el modo de permisos de esta sesión (¿hooks de nav sin instalar?). Lanzando con --dangerously-skip-permissions, que es lo que nav ha hecho siempre." >&2
      permission_flag="--dangerously-skip-permissions"
    fi
  fi

  # Linaje para el árbol de "nav list": si quien ejecuta "nav spawn" lo hace
  # desde una sesión de Claude Code registrada, el hijo se apunta de quién
  # viene. Best-effort — si se lanza a mano desde una shell normal (sin
  # sesión registrada en $PWD), el hijo simplemente no tiene padre conocido
  # y "nav list" lo trata como raíz.
  local parent_cwd="$PWD" parent_session_id
  parent_session_id=$(registry_get "$PWD" | jq -r '.session_id // empty' 2>/dev/null) || true
  [ -z "$parent_session_id" ] && parent_cwd=""

  local launcher
  launcher=$(spawn_build_launcher "$target_path" "$prompt" "$remote_name" "$permission_flag" "$fork_session_id" "$parent_cwd" "$parent_session_id")

  if [ "$mode" = "window" ]; then
    osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  do script "'$launcher'"
end tell
APPLESCRIPT
  else
    # "do script ... in front window" no crea pestaña de forma fiable en
    # Terminal.app (a veces abre ventana igualmente). El truco que sí
    # funciona: simular Cmd+T (requiere permiso de Accesibilidad) para
    # forzar una pestaña nueva y lanzar el comando en ella.
    #
    # "activate" es asíncrono: deja el Apple Event enviado y no espera a que
    # Terminal sea de verdad la app frontal a nivel de macOS. Medido el
    # 20-ago-2026: sin esperar a que se complete, el Cmd+T podía llegar antes
    # de que Terminal tuviera una "ventana clave" a la que añadir el tab, y
    # entonces abría una ventana nueva en su lugar — silenciosamente, sin
    # error. De ahí el sondeo: como mucho 1.5s, saliendo en cuanto conste que
    # Terminal ya es frontmost. Margen deliberadamente generoso: el coste de
    # esperar de más es un spawn algo más lento; el de esperar de menos es
    # una ventana suelta con un solo tab.
    if [ "$(osascript -e 'tell application "Terminal" to count windows')" -gt 0 ]; then
      osascript <<APPLESCRIPT
tell application "Terminal" to activate
repeat 30 times
  if frontmost of application "Terminal" then exit repeat
  delay 0.05
end repeat
tell application "System Events" to keystroke "t" using command down
delay 0.4
tell application "Terminal"
  do script "'$launcher'" in front window
end tell
APPLESCRIPT
    else
      osascript <<APPLESCRIPT
tell application "Terminal"
  activate
  do script "'$launcher'"
end tell
APPLESCRIPT
    fi
  fi
}

cmd_worktrees() {
  local project_path="${1:-}"
  if [ -z "$project_path" ] || [ ! -d "$project_path" ]; then
    echo "Uso: nav worktrees <ruta-dentro-del-proyecto>" >&2
    exit 1
  fi

  local live_by_path
  live_by_path=$(registry_list_live | jq -s 'map({(.worktree // .cwd): .status}) | add // {}')

  if ! git -C "$project_path" rev-parse --show-toplevel > /dev/null 2>&1; then
    echo "'$project_path' no es un repositorio git." >&2
    exit 1
  fi

  git -C "$project_path" worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { path=substr($0,10) }
    /^branch /   { branch=substr($0,8); sub(/^refs\/heads\//, "", branch); print path"\t"branch; path=""; branch="" }
    /^detached/  { print path"\t(detached)"; path="" }
  ' | while IFS=$'\t' read -r path branch; do
    local status
    status=$(echo "$live_by_path" | jq -r --arg p "$path" '.[$p] // "sin sesión"')
    printf "   %s  %-25s %s\n" "$(status_icon "$status")" "$branch" "$path"
  done || true
}

# Da de alta sesiones de Claude Code que ya estaban corriendo antes de
# instalar los hooks (o que por lo que sea aún no han pasado por ninguno):
# busca procesos "claude" en primer plano de un tty real, resuelve su cwd
# con lsof, y las registra si no lo estaban ya (o si la entrada existente
# tenía un pid muerto). El bootstrap de hook-handler.sh cubre el "se
# autorregistra la próxima vez que la toques"; esto es el "quiero verlas
# YA, sin tocar cada una".
cmd_scan() {
  local found=0
  local line pid tty comm cwd existing_pid git_info now patch

  # Reconciliación completa, no solo "añadir": purga primero las entradas
  # con pid muerto (registry_list_live ya lo hace como efecto colateral de
  # listar) para poder informar de cuántas se han limpiado.
  local before_count after_count purged
  before_count=$(find "$REGISTRY_DIR" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
  registry_list_live > /dev/null
  after_count=$(find "$REGISTRY_DIR" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
  purged=$((before_count - after_count))

  while IFS= read -r line; do
    pid=$(echo "$line" | awk '{print $1}')
    tty=$(echo "$line" | awk '{print $3}')
    comm=$(echo "$line" | awk '{print $4}')
    [ "$comm" != "claude" ] && continue
    [ "$tty" = "??" ] && continue

    cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | awk '/^n/{sub(/^n/,""); print; exit}') || true
    [ -z "$cwd" ] && continue

    existing_pid=$(registry_get "$cwd" | jq -r '.pid // empty' 2>/dev/null) || true
    if [ -n "$existing_pid" ] && registry_pid_alive "$existing_pid"; then
      continue
    fi

    git_info=$(registry_git_info "$cwd")
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    patch=$(jq -n \
      --arg cwd "$cwd" --arg pid "$pid" --arg tty "$tty" \
      --arg status "unknown" --arg updated_at "$now" \
      --argjson git "$git_info" \
      '{cwd:$cwd, pid:($pid|tonumber), tty:$tty, status:$status, updated_at:$updated_at} * $git')
    registry_merge "$cwd" "$patch"
    found=$((found + 1))
    echo "  + $cwd"
  done < <(ps -eo pid=,ppid=,tty=,comm=)

  echo ""
  if [ "$purged" -gt 0 ]; then
    echo "🗑  $purged sesión(es) muerta(s) purgada(s) del registro."
  fi
  if [ "$found" -eq 0 ]; then
    echo "Nada nuevo que registrar (todas las sesiones activas ya estaban en el registro)."
  else
    echo "$found sesión(es) registrada(s). Su estado real (working/blocked/idle) se"
    echo "actualizará en cuanto interactúes con cada una; hasta entonces aparecen como ❔."
  fi
}

# Libera un worktree con seguridad. Por defecto SOLO quita el worktree
# (barato, reversible: la rama y sus commits siguen ahí). Borrar la rama
# es un paso aparte, explícito, y usa "branch -d" (seguro, se niega si no
# está mergeada) salvo que se pida --force expresamente — nunca "-D" por
# defecto, nunca en silencio.
# ¿Está el contenido de esta rama a salvo fuera de su worktree?
#
# Devuelve, separados por '|': nº de commits que NO están en la base, el PR
# mergeado (o vacío), y si la rama remota sigue existiendo.
#
# La base es `origin/<rama-principal>`, NUNCA la rama principal local: medido el
# 18-ago-2026, un `main` local dos PR por detrás hacía que una rama recién
# creada apareciese con 37 commits propios. Comparar contra una base vieja
# inventa trabajo que no existe (y, al revés, puede ocultarlo).
sweep_safety() {
  local root="$1" branch="$2" base="$3"
  local propios pr remota

  propios=$(git -C "$root" log --oneline "$branch" --not "$base" 2>/dev/null | wc -l | tr -d ' ')

  # El PR mergeado es la ÚNICA señal fiable con squash-merge: al aplastar, el
  # commit resultante no comparte identidad con los de la rama, así que
  # `git branch --merged` nunca la ve. Y al revés — hay ramas integradas por
  # merge commit sin PR asociado; por eso esto se combina con `propios`, no
  # sustituye a nada.
  pr=""
  if command -v gh >/dev/null 2>&1; then
    pr=$(cd "$root" && gh pr list --head "$branch" --state merged --json number --jq '.[0].number' 2>/dev/null) || true
  fi

  if [ -n "$(git -C "$root" ls-remote --heads origin "$branch" 2>/dev/null)" ]; then
    remota="viva"
  else
    remota="borrada"
  fi

  echo "${propios}|${pr}|${remota}"
}

# nav sweep — QUÉ se puede retirar, y por qué. No borra nunca: el borrado es
# `nav prune <ruta>`, nominal y de uno en uno.
#
# Esa separación es deliberada. Un barrido que decide Y ejecuta puede llevarse
# por delante media docena de worktrees por un solo fallo de señal; obligando a
# nombrar cada uno, el peor caso es perder uno. Y como `prune` re-comprueba todo
# en el instante de borrar, un informe viejo no puede hacer daño.
cmd_sweep() {
  local target_path="$PWD" do_fetch=true
  # La ruta es opcional y los flags también, así que no se puede dar por hecho
  # que $1 sea la ruta: `nav sweep --no-fetch` tomaba el flag como ruta y moría
  # con «'--no-fetch' no está dentro de un repo git».
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-fetch) do_fetch=false; shift ;;
      -*) echo "Opción desconocida: $1" >&2; exit 1 ;;
      *) target_path="$1"; shift ;;
    esac
  done

  local root
  root=$(git -C "$target_path" worktree list 2>/dev/null | head -1 | awk '{print $1}') || true
  if [ -z "$root" ]; then
    echo "'$target_path' no está dentro de un repo git." >&2
    exit 1
  fi

  local main_branch base
  main_branch=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||') || true
  [ -z "$main_branch" ] && main_branch="main"
  base="origin/$main_branch"

  if [ "$do_fetch" = "true" ]; then
    echo "Actualizando referencias de origin (--no-fetch para saltarlo)…" >&2
    git -C "$root" fetch --prune --quiet origin 2>/dev/null || \
      echo "Aviso: el fetch falló; se evalúa contra las referencias locales, que pueden estar viejas." >&2
  fi

  if ! git -C "$root" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    echo "No existe '$base'. Sin una base fiable no se puede decidir nada: se aborta." >&2
    exit 1
  fi

  local podables=() conservar=() enuso=()

  while IFS=$'\t' read -r wt ref; do
    local branch; branch=${ref#refs/heads/}
    [ "$wt" = "$root" ] && continue
    [ "$branch" = "$main_branch" ] && continue

    local pid entry alive=false
    entry=$(registry_get "$wt" 2>/dev/null) || true
    pid=$(echo "$entry" | jq -r '.pid // empty' 2>/dev/null) || true
    if [ -n "$pid" ] && registry_session_alive "$pid" "$wt"; then alive=true; fi

    local sucios; sucios=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    local info propios pr remota
    info=$(sweep_safety "$root" "$branch" "$base")
    propios=${info%%|*}; info=${info#*|}
    pr=${info%%|*}; remota=${info#*|}

    if [ "$alive" = "true" ]; then
      enuso+=("$wt|$branch|sesión viva (pid $pid)")
    elif [ "$sucios" != "0" ]; then
      conservar+=("$wt|$branch|$sucios cambios sin commitear")
    elif [ "$propios" != "0" ]; then
      if [ -z "$pr" ] && [ "$remota" = "borrada" ]; then
        conservar+=("$wt|$branch|⚠ $propios commits que NO están en $base, sin PR y con la rama remota borrada — este trabajo no está en ningún otro sitio")
      else
        conservar+=("$wt|$branch|$propios commits que no están en $base")
      fi
    elif [ -n "$pr" ]; then
      podables+=("$wt|$branch|PR #$pr mergeado · árbol limpio · nada fuera de $base")
    else
      podables+=("$wt|$branch|contenido íntegro en $base · árbol limpio")
    fi
  done < <(git -C "$root" worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{print w"\t"$2}')

  local fila
  if [ ${#enuso[@]} -gt 0 ]; then
    echo
    echo "EN USO — no se tocan"
    for fila in "${enuso[@]}"; do
      printf "  %-46s %s\n" "$(basename "${fila%%|*}")" "${fila##*|}"
    done
  fi

  if [ ${#conservar[@]} -gt 0 ]; then
    echo
    echo "CONSERVAR — tienen algo que perder"
    for fila in "${conservar[@]}"; do
      printf "  %-46s %s\n" "$(basename "${fila%%|*}")" "${fila##*|}"
    done
  fi

  if [ ${#podables[@]} -eq 0 ]; then
    echo
    echo "Nada que retirar."
    return
  fi

  echo
  echo "PODABLES — su contenido está a salvo"
  for fila in "${podables[@]}"; do
    printf "  %-46s %s\n" "$(basename "${fila%%|*}")" "${fila##*|}"
  done
  echo
  # Sin backticks: dentro de comillas dobles bash los EJECUTA (aquí llegó a
  # lanzar un 'nav prune' sin argumentos en mitad del informe).
  echo "Para retirarlos, uno a uno — cada prune vuelve a comprobarlo todo:"
  for fila in "${podables[@]}"; do
    echo "  nav prune ${fila%%|*} --delete-branch"
  done
}

cmd_prune() {
  local target_path="${1:-}"
  shift || true
  local delete_branch=false force=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --delete-branch) delete_branch=true; shift ;;
      --force) force=true; shift ;;
      *) shift ;;
    esac
  done

  if [ -z "$target_path" ] || [ ! -d "$target_path" ]; then
    echo "Uso: nav prune <ruta-del-worktree> [--delete-branch [--force]]" >&2
    exit 1
  fi
  target_path=$(cd "$target_path" && pwd)

  local live_pid
  live_pid=$(registry_get "$target_path" | jq -r '.pid // empty' 2>/dev/null) || true
  # registry_session_alive, no registry_pid_alive: los PID se reciclan, y aquí
  # confundirse significa borrar el worktree de una sesión que está trabajando.
  if [ -n "$live_pid" ] && registry_session_alive "$live_pid" "$target_path"; then
    echo "Hay una sesión de Claude Code viva en '$target_path' (pid $live_pid)." >&2
    echo "Ciérrala antes de continuar." >&2
    exit 1
  fi

  local branch project_root
  branch=$(git -C "$target_path" branch --show-current 2>/dev/null) || true
  project_root=$(git -C "$target_path" worktree list 2>/dev/null | head -1 | awk '{print $1}') || true
  if [ -z "$project_root" ]; then
    echo "'$target_path' no es un worktree git." >&2
    exit 1
  fi

  if [ -n "$(git -C "$target_path" status --porcelain 2>/dev/null)" ]; then
    echo "'$target_path' tiene cambios sin commitear." >&2
    echo "Revísalos y commitea o descarta a mano antes de continuar — no se toca nada." >&2
    exit 1
  fi

  git -C "$project_root" worktree remove "$target_path"
  registry_remove "$target_path"
  echo "✓ Worktree liberado: $target_path"

  if [ -z "$branch" ]; then
    echo "No se pudo determinar la rama; no se borra ninguna."
    return
  fi

  if [ "$delete_branch" != "true" ]; then
    echo "Rama '$branch' conservada (usa --delete-branch para borrarla)."
    return
  fi

  if [ "$force" = "true" ]; then
    git -C "$project_root" branch -D "$branch"
    echo "✓ Rama '$branch' borrada (forzado con --force — commits incluidos)."
    return
  fi

  # `git branch -d` compara contra el HEAD del repo, es decir contra la rama
  # principal LOCAL. Si esa va por detrás de origin —lo normal después de un
  # rato trabajando— su veredicto no vale para nada: medido el 18-ago-2026, un
  # `main` local dos PR por detrás daba 37 commits propios a una rama recién
  # sacada de main.
  #
  # Antes de dejarle decidir, se actualizan las referencias y se comprueba
  # contra `origin/<principal>`. Si la rama tiene commits que ahí no están, se
  # para aquí: `-d` los habría dado por perdidos o por salvados según el humor
  # del repo local.
  local main_branch base propios
  main_branch=$(git -C "$project_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||') || true
  [ -z "$main_branch" ] && main_branch="main"
  base="origin/$main_branch"
  git -C "$project_root" fetch --prune --quiet origin 2>/dev/null || true

  if git -C "$project_root" rev-parse --verify --quiet "$base" >/dev/null 2>&1; then
    propios=$(git -C "$project_root" log --oneline "$branch" --not "$base" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$propios" != "0" ]; then
      echo "Worktree liberado, pero la rama '$branch' NO se ha borrado." >&2
      echo "Tiene $propios commit(s) que no están en $base." >&2
      echo "Míralos con:  git log --oneline $branch --not $base" >&2
      echo "Si de verdad sobran, repite con --delete-branch --force." >&2
      exit 1
    fi
  fi

  if git -C "$project_root" branch -d "$branch"; then
    echo "✓ Rama '$branch' borrada (su contenido está en $base)."
  else
    # Caso típico con squash-merge: el contenido está en la base pero los
    # commits no coinciden, así que `-d` se niega. Ya sabemos por la
    # comprobación de arriba que no hay nada fuera de la base.
    if git -C "$project_root" branch -D "$branch"; then
      echo "✓ Rama '$branch' borrada (integrada por squash: sin commits propios fuera de $base)."
    else
      echo "No se pudo borrar la rama '$branch'." >&2
      exit 1
    fi
  fi
}

case "${1:-list}" in
  list) cmd_list ;;
  jump) shift; cmd_jump "$@" ;;
  spawn) shift; cmd_spawn "$@" ;;
  worktrees) shift; cmd_worktrees "$@" ;;
  sweep) shift; cmd_sweep "$@" ;;
  scan) cmd_scan ;;
  prune) shift; cmd_prune "$@" ;;
  *)
    echo "Uso: nav [list|jump <patrón>|spawn <ruta>|worktrees <ruta>|sweep [<ruta>] [--no-fetch]|scan|prune <ruta> [--delete-branch [--force]]]" >&2
    exit 1
    ;;
esac
